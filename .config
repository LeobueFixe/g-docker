server {
    listen 443 ssl;
    server_name localhost;

    ssl_certificate /etc/nginx/certs/cert.crt;
    ssl_certificate_key /etc/nginx/certs/cert.key;

    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    location / { 
        try_files $uri $uri/ =404; 
    }
}

server { 
    listen 80; 
    return 301 https://$host$request_uri;
}
